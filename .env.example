# Copy this file to .env.local and fill in your own values to enable GitHub Gist persistence.
# Leave both unset and the app runs in its default browser-only storage mode — IndexedDB, with
# localStorage as the fallback — which needs no setup at all and never touches the network.
# Setting a token is itself the opt-in to Gist sync, so a build that has one starts in that mode
# (switchable per browser; see README.md → Persistence modes).

# A GitHub personal access token with the "gist" scope.
VITE_GITHUB_TOKEN=

# Id of an existing private Gist to store app data in. Optional: if VITE_GITHUB_TOKEN is set but
# this is left blank, the app creates a new private Gist itself on first save.
VITE_GIST_ID=
