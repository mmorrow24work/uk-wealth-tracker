# Copy this file to .env.local and fill in your own values to enable GitHub Gist persistence.
# Leave both unset for local dev without Gist setup — the app falls back to localStorage.

# A GitHub personal access token with the "gist" scope.
VITE_GITHUB_TOKEN=

# Id of an existing private Gist to store app data in. Optional: if VITE_GITHUB_TOKEN is set but
# this is left blank, the app creates a new private Gist itself on first save.
VITE_GIST_ID=
