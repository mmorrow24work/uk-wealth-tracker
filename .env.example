# Copy this file to .env.local to configure GitHub Gist persistence at build time.
#
# You probably do not need this. The app's Connect GitHub page (the indicator in the header) signs
# you in from inside the app, keeping the token in your browser rather than in the deployed
# JavaScript — see README.md -> Connecting GitHub. These variables exist for deployments configured
# before that page existed, and are used only when nobody has signed in on this browser.
#
# Leave both unset and the app runs in its default browser-only storage mode - IndexedDB, with
# localStorage as the fallback - which needs no setup at all and never touches the network.

# A GitHub personal access token with the "gist" scope. VITE_-prefixed variables are inlined into
# the client bundle, so anyone who can read the deployed JavaScript can read this token.
VITE_GITHUB_TOKEN=

# Id of an existing private Gist to store app data in. Optional: if VITE_GITHUB_TOKEN is set but
# this is left blank, the app creates a new private Gist itself on first save. A Gist chosen or
# created in the app takes precedence over this one.
VITE_GIST_ID=

# An Alpha Vantage API key (free, no card needed: https://www.alphavantage.co/support/#api-key),
# configures live share/fund price lookups (issue #266) for holdings with a ticker set. Same
# "inlined into the deployed bundle" caveat as VITE_GITHUB_TOKEN above applies to this variable
# too, but it matters less here: this key only ever reads public market quotes, never anything of
# yours. Leave unset and ticker stays a plain manual-entry reference field, same as today.
VITE_ALPHA_VANTAGE_API_KEY=
